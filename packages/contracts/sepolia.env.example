# Copy to .env.sepolia and fill locally. .env.sepolia is ignored by Git.
# Never add a private key or mnemonic to this file.

# Alchemy/Infura Ethereum Sepolia HTTPS endpoint. Secret: keep local.
SEPOLIA_RPC_URL=

# Etherscan API key used only for source verification. Secret: keep local.
ETHERSCAN_API_KEY=

# Foundry encrypted keystore account name. This is not a private key.
DEPLOYER_ACCOUNT=web3-university-sepolia

# Public 0x address that will receive the complete 80,000,000 YD supply.
TREASURY_ADDRESS=


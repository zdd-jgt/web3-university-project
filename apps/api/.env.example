# Local values only. Production secrets belong in a secret manager, never Git.
APP_ENV=local
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://web3u:web3u@localhost:5432/web3u?schema=public
REDIS_URL=redis://localhost:6379
RATE_LIMIT_KEY_SECRET=replace-with-a-long-random-value

CHAIN_ID=11155111
CHAIN_RPC_URL=
COURSE_CATALOG_ADDRESS=
COURSE_MARKET_ADDRESS=

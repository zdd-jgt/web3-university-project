LOCAL_PURCHASED_COURSE_IDS=

PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_VERIFICATION_KEY=
PROFILE_VERIFYING_CONTRACT=0x0000000000000000000000000000000000000001
LOCAL_ADMIN_SUBJECT=local-admin

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=web3-university-videos
S3_ACCESS_KEY=minio
S3_SECRET_KEY=change-me-now

# Production read URLs use CloudFront signed URLs instead of S3 presigning.

{
  "name": "web3-university-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": ">=24.14.0",
    "pnpm": ">=10.32.0"
  },
  "volta": {
    "node": "24.14.0",
    "pnpm": "10.32.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check:ci": "biome ci .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8"
  }
}
